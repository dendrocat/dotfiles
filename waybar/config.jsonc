{
	"layer": "top",
	"position": "top",
	// "position": "bottom",
	"height": 32,

	"include": ["./modules/*"],

	"modules-left": ["hyprland/workspaces"],
	"modules-center": ["clock"],
	"modules-right": [
		"tray",
		"memory",
		"hyprland/language",
		"backlight",
		"pulseaudio",
		"group/wifi-blue-bat",
		"custom/notification",
	],

	"hyprland/workspaces": {
		"format": "{name}: {icon}",
		"format-icons": {
			"default": "",
			"active": "",
			"empty": "",
		},
		"persistent-workspaces": {
			"*": 5,
		},
	},

	"hyprland/window": {
		"max-length": 60,
		"separate-outputs": true,
	},

	"tray": {
		"icon-size": 19,
		"spacing": 10,
	},

	"memory": {
		"format": "{used} GiB",
	},

	"hyprland/language": {
		"format": "{short}",
	},

	"clock": {
		"format": "{:%H:%M • %d.%m.%Y}",
		"tooltip-format": "{:%d} {calendar}",
	},

	"group/wifi-blue-bat": {
		"orientation": "horizontal",
		"modules": ["network", "bluetooth", "battery"],
	},

	"backlight": {
		"format": "{icon} {percent}%",
		"format-icons": [
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"",
		],
		"scroll-step": 5,
	},
}
